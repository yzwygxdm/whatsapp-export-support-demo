# Copy to .env and add a key to enable a real OpenAI-compatible model.
# Leave OPENAI_API_KEY empty to run the safe, rule-based agent demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
PORT=4174
# Set this only when the frontend is hosted on a different origin than server.js.
FRONTEND_ORIGIN=
